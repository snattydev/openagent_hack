{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "rootDir": "."
  },
  "include": ["hardhat.config.ts", "contracts/**/*", "scripts/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
