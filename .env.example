# ═══════════════════════════════════════════════════════════════════════════════
# CapyMate — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# QUICK START (Agent Plugin Mode — no API keys needed):
#   1. cp .env.example .env
#   2. npm run dev
#   3. Host agent calls POST /api/sense → gets market data
#   4. Host agent calls POST /api/decide ← injects its own LLM decision
#
# REAL MODE (autonomous trading with API keys):
#   Fill in the keys below and set USE_MOCK_SERVICES=false DRY_RUN=false
# ═══════════════════════════════════════════════════════════════════════════════

# ── Network ────────────────────────────────────────────────────────────────────
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0x...                    # Testnet wallet only!

# ── LLM (optional when using agent plugin mode) ────────────────────────────────
# The host agent provides reasoning via POST /api/decide.
# Only needed for autonomous mode where CapyMate calls the LLM itself.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── 0G Storage (optional — falls back to local JSON) ───────────────────────────
ZERO_G_ENDPOINT=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_API_KEY=                        # Leave empty for local JSON fallback

# ── Execution (optional — falls back to direct RPC) ────────────────────────────
KEEPER_HUB_API_KEY=                    # Leave empty for direct RPC fallback

# ── Trading (optional — rate limits apply without key) ─────────────────────────
UNISWAP_API_KEY=                       # From developers.uniswap.org

# ── News (optional — mock headlines work without key) ──────────────────────────
CRYPTOPANIC_API_KEY=

# ── Agent Behavior ─────────────────────────────────────────────────────────────
POLLING_INTERVAL_MS=300000             # 5 minutes between auto-cycles
PORT=3000                              # REST API port
DRY_RUN=true                           # Log trades but don't broadcast
USE_MOCK_SERVICES=true                 # Mock data when no real credentials
