# CapyMate — Environment Configuration
# Copy to .env and fill in your values

# Network
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0x...

# LLM (required for autonomous mode)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# 0G Storage (optional — falls back to local JSON)
ZERO_G_ENDPOINT=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_API_KEY=

# Execution (optional — falls back to direct RPC)
KEEPER_HUB_API_KEY=

# Trading (optional — rate limits apply without key)
UNISWAP_API_KEY=

# News (optional — returns empty if no key)
CRYPTOPANIC_API_KEY=

# Agent Behavior
POLLING_INTERVAL_MS=300000
PORT=3000
DRY_RUN=false
